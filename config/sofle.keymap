#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define FN 4

/ {
    behaviors {
        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_exclamation {
            timeout-ms = <40>;
            key-positions = <13 25>;
            bindings = <&kp EXCL>;
            layers = <BASE>;
        };

        combo_at {
            timeout-ms = <40>;
            key-positions = <14 26>;
            bindings = <&kp AT>;
            layers = <BASE>;
        };

        combo_hash {
            timeout-ms = <40>;
            key-positions = <15 27>;
            bindings = <&kp HASH>;
            layers = <BASE>;
        };

        combo_dollar {
            timeout-ms = <40>;
            key-positions = <16 28>;
            bindings = <&kp DLLR>;
            layers = <BASE>;
        };

        combo_percent {
            timeout-ms = <40>;
            key-positions = <17 29>;
            bindings = <&kp PRCNT>;
            layers = <BASE>;
        };

        combo_caret {
            timeout-ms = <40>;
            key-positions = <18 30>;
            bindings = <&kp CARET>;
            layers = <BASE>;
        };

        combo_ampersand {
            timeout-ms = <40>;
            key-positions = <19 31>;
            bindings = <&kp AMPS>;
            layers = <BASE>;
        };

        combo_asterisk {
            timeout-ms = <40>;
            key-positions = <20 32>;
            bindings = <&kp ASTRK>;
            layers = <BASE>;
        };

        combo_left_brace {
            timeout-ms = <40>;
            key-positions = <3 4>;
            bindings = <&kp LBRC>;
            layers = <BASE>;
        };

        combo_left_bracket {
            timeout-ms = <40>;
            key-positions = <15 16>;
            bindings = <&kp LBKT>;
            layers = <BASE>;
        };

        combo_left_parenthesis {
            timeout-ms = <40>;
            key-positions = <27 28>;
            bindings = <&kp LPAR>;
            layers = <BASE>;
        };

        combo_less_than {
            timeout-ms = <40>;
            key-positions = <39 40>;
            bindings = <&kp LT>;
            layers = <BASE>;
        };

        combo_right_brace {
            timeout-ms = <40>;
            key-positions = <7 8>;
            bindings = <&kp RBRC>;
            layers = <BASE>;
        };

        combo_right_bracket {
            timeout-ms = <40>;
            key-positions = <19 20>;
            bindings = <&kp RBKT>;
            layers = <BASE>;
        };

        combo_right_parenthesis {
            timeout-ms = <40>;
            key-positions = <31 32>;
            bindings = <&kp RPAR>;
            layers = <BASE>;
        };

        combo_greater_than {
            timeout-ms = <40>;
            key-positions = <45 46>;
            bindings = <&kp GT>;
            layers = <BASE>;
        };

        combo_minus {
            timeout-ms = <40>;
            key-positions = <29 30>;
            bindings = <&kp MINUS>;
            layers = <BASE>;
        };

        combo_underscore {
            timeout-ms = <40>;
            key-positions = <40 41>;
            bindings = <&kp UNDER>;
            layers = <BASE>;
        };

        combo_delete {
            timeout-ms = <40>;
            key-positions = <11 23>;
            bindings = <&kp DEL>;
            layers = <BASE>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "1";
            bindings = <
&kp ESC    &kp N1     &kp N2    &kp N3   &kp N4     &kp N5                              &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q      &kp W     &kp E    &kp R      &kp T                               &kp Y   &kp U     &kp I      &kp O    &kp P     &kp BSLH
&none      &kp A      &kp S     &kp D    &kp F      &kp G                               &kp H   &kp J     &kp K      &kp L    &kp SEMI  &kp SINGLE_QUOTE
&kp LSHFT  &kp Z      &kp X     &kp C    &kp V      &kp B      &kp C_MUTE    &kp HOME   &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH  &none
                    &kp LCTRL  &kp LGUI  &kp LALT  &kp SPACE  &mo LOWER    &mo RAISE  &kp ENTER  &kp RCTRL  &none    &none
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT &inc_dec_kp DOWN UP>;
        };

        lower_layer {
            display-name = "2";

            bindings = <
&kp F12    &kp F1     &kp F2     &kp F3     &kp F4     &kp F5                             &kp F6   &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
&kp GRAVE  &none      &none       &kp LG(E)  &kp LG(R)  &none                              &kp INS  &kp HOME  &kp PG_UP &none      &kp UP    &kp F12
&kp CAPS   &kp LC(A)  &kp LC(S)   &none       &kp LC(F)  &none                              &kp DEL  &kp END   &kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT
&none      &kp LC(Z)  &kp LC(X)   &kp LC(C)  &kp LC(V)  &none  &kp C_MUTE  &kp HOME       &none    &none      &none      &none      &none      &none
                       &none       &none       &none      &none  &none       &mo RAISE     &none    &none      &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_DN PG_UP>;
        };

        raise_layer {
            display-name = "3";
            bindings = <
&none  &none  &none  &none  &none  &none                        &kp KP_PLUS      &kp KP_N7     &kp KP_N8  &kp KP_N9   &none         &none
&none  &none  &none  &none  &none  &none                        &kp KP_MINUS     &kp KP_N4     &kp KP_N5  &kp KP_N6   &none         &none
&none  &none  &none  &none  &none  &none                        &kp KP_MULTIPLY  &kp KP_N1     &kp KP_N2  &kp KP_N3   &none         &none
&none  &none  &none  &none  &none  &none  &trans  &trans        &kp KP_DIVIDE    &kp KP_EQUAL  &kp KP_N0  &kp KP_DOT  &kp KP_ENTER &kp KP_NUMLOCK
              &none  &none  &none  &none  &mo LOWER             &none            &none         &none       &none        &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "4";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0      &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4                                  &none            &none            &none            &none            &none            &none
&rgb_ug RGB_ON     &rgb_ug RGB_EFF   &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI                             &none            &none            &none            &none            &none            &none
&rgb_ug RGB_OFF    &rgb_ug RGB_EFR   &rgb_ug RGB_SPD  &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD                             &none            &none            &none            &none            &none            &none
&none              &none             &none            &none            &none         &none             &rgb_ug RGB_TOG  &none          &none            &none            &none            &none            &none            &none
                                      &none            &none            &none         &none             &none            &none          &none            &none            &none            &none
            >;

            sensor-bindings = <&inc_dec_msc SCRL_RIGHT SCRL_LEFT &inc_dec_msc SCRL_UP SCRL_DOWN>;
        };

        fn_layer {
            display-name = "5";
            bindings = <
&none  &none  &none  &none  &none  &none                    &none           &none         &none        &none       &none             &none
&none  &none  &none  &none  &none  &none                    &none           &none         &none        &none       &kp C_PLAY_PAUSE  &kp PRINTSCREEN
&none  &none  &none  &none  &none  &none                    &kp C_PREV      &kp C_VOL_DN  &kp C_VOL_UP &kp C_NEXT  &none             &none
&none  &none  &none  &none  &none  &none  &none    &none    &kp K_PREVIOUS  &kp C_MUTE    &kp K_APP    &kp K_NEXT  &none             &none
              &none  &none  &none  &none  &none    &none    &none           &none         &none        &none
            >;

            sensor-bindings = <&inc_dec_kp 0 0 &inc_dec_kp 0 0>;
        };
    };
};
