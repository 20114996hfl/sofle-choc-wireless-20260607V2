#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/encoder.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC   &kp Q       &kp W       &kp E       &kp R       &kp T       &kp Y       &kp U       &kp I       &kp O       &kp P       &kp BSPACE
                &kp TAB   &kp A       &kp S       &kp D       &kp F       &kp G       &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp QUOT
                &kp LSFT  &kp Z       &kp X       &kp C       &kp V       &kp B       &kp N       &kp M       &kp COMMA   &kp DOT     &kp SLASH   &kp RSFT
                &kp LCTRL &kp LGUI    &kp LALT    &mo 1       &kp SPC     &kp SPC     &mo 2       &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT
            >;
        };

        function_layer {
            bindings = <
                &kp GRAVE &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp DEL
                &trans    &kp F11     &kp F12     &trans      &trans      &trans      &trans      &kp HOME    &kp PGDN    &kp PGUP    &trans      &kp ENT
                &trans    &trans      &trans      &trans      &trans      &trans      &trans      &kp END     &kp MINUS   &kp EQUAL   &kp BSLH    &trans
                &trans    &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
            >;
        };

        number_layer {
            bindings = <
                &trans    &kp NUM_1   &kp NUM_2   &kp NUM_3   &kp NUM_4   &kp NUM_5   &kp NUM_6   &kp NUM_7   &kp NUM_8   &kp NUM_9   &kp NUM_0   &trans
                &trans    &trans      &trans      &trans      &trans      &trans      &trans      &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &trans
                &trans    &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
                &trans    &trans      &trans      &trans      &trans      &trans      &trans      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
            >;
        };

        mouse_layer {
            bindings = <
                &trans    &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
                &trans    &trans      &trans      &trans      &trans      &trans      &trans      &mouse BTN_LEFT &mouse BTN_MIDDLE &mouse BTN_RIGHT &trans &trans
                &trans    &trans      &trans      &trans      &trans      &trans      &trans      &mouse BTN_BACK &mouse BTN_FORWARD &trans &trans &trans
                &trans    &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
            >;
        };
    };

    encoders {
        compatible = "zmk,encoders";
        left_encoder: encoder_left {
            compatible = "zmk,encoder";
            label = "LEFT_ENCODER";
            encoder-gpios = <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>,
                           <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
            resolution = <4>;
            bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            layer-bindings = <1 &inc_dec_kp C_VOL_UP C_VOL_DN>,
                            <2 &inc_dec_kp PG_UP PG_DN>,
                            <3 &inc_dec_mouse MOUSE_WHEEL_DOWN MOUSE_WHEEL_UP>;
        };
    };
};
