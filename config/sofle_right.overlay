/*
 * Copyright (c) 2023 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 *
 * Sofle Choc Wireless (right half / peripheral) overlay for RGB underglow and OLED.
 * Pin assignments based on db-ok/SofleChocWireless reference project:
 *   https://github.com/db-ok/SofleChocWireless
 *   https://github.com/db-ok/zmk-config-soflechocwireless
 *
 * Pin mapping confirmed from hardware:
 *   RGB SPI : schematic LED net / DIN = P0.08
 *   PCB CS  : P0.06 (not the WS2812 data signal)
 *   OLED I2C: SDA = P0.17, SCL = P0.20
 *
 * The built-in Sofle OLED node uses I2C0. Only its ProMicroNRF52840 pinctrl is
 * retained here explicitly to match this PCB.
 */

#include <dt-bindings/led/led.h>
#include <dt-bindings/gpio/gpio.h>

/* Keep the SuperMini 3.3 V VCC output enabled for the OLED and RGB rail. */
&{/EXT_POWER} {
    status = "disabled";
};

&gpio0 {
    vcc_enable_hog: vcc_enable_hog {
        gpio-hog;
        gpios = <13 GPIO_ACTIVE_HIGH>;
        output-high;
        line-name = "supermini-vcc-enable";
    };
};

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 8)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 8)>;
            low-power-enable;
        };
    };

};

&i2c0_default {
    group1 {
        psels = <NRF_PSEL(TWIM_SDA, 0, 17)>, <NRF_PSEL(TWIM_SCL, 0, 20)>;
    };
};

&i2c0_sleep {
    group1 {
        psels = <NRF_PSEL(TWIM_SDA, 0, 17)>, <NRF_PSEL(TWIM_SCL, 0, 20)>;
        low-power-enable;
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        label = "WS2812";

        /* SPI */
        reg = <0>;
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <30>; /* Single half: 30 WS2812 LEDs (underglow) */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <100000>;

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        /* Match the upstream Sofle SSD1306 node: black background, white pixels. */
        inversion-on;
        prechargep = <0x22>;
    };
};

/ {
    chosen {
        zmk,underglow = &led_strip;
        zephyr,display = &oled;
    };
};
